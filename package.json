{
  "name": "@reactive/state",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm start --prefix examples/server",
    "server:dev": "npm run dev --prefix examples/server",
    "example:svelte": "npm run dev --prefix examples/svelte",
    "example:react": "npm run dev --prefix examples/react",
    "example:vue": "npm run dev --prefix examples/vue",
    "example:angular": "npm run start --prefix examples/angular",
    "check:examples": "npm run check --prefix examples/svelte && npm run typecheck --prefix examples/react && npm run type-check --prefix examples/vue && npm run build --prefix examples/angular",
    "install:examples": "npm install --prefix examples/server && npm install --prefix examples/svelte && npm install --prefix examples/react && npm install --prefix examples/vue && npm install --prefix examples/angular"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.31",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "9.26.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "jiti": "^2.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "rxjs": "^7.8.2",
    "valibot": "^1.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.51.2",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
